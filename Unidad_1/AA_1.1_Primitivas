function setup() {
  createCanvas(400, 400);

  background(130, 200, 255);

  stroke(0, 0, 0);
  strokeWeight(2);

  fill(180, 130, 90);
  rect(140, 50, 120, 120);

  fill(90, 50, 30);
  rect(140, 50, 120, 30);

  fill(255, 255, 255);
  ellipse(170, 110, 25, 20);
  ellipse(230, 110, 25, 20);

  fill(0, 0, 200);
  ellipse(170, 110, 10, 10);
  ellipse(230, 110, 10, 10);

  fill(150, 90, 60);
  triangle(190, 125, 210, 125, 200, 140);

  line(185, 150, 215, 150);

  fill(0, 180, 180);
  rect(140, 170, 120, 100);

  fill(180, 130, 90);
  rect(100, 170, 40, 100);
  rect(260, 170, 40, 100);

  fill(50, 50, 180);
  rect(145, 270, 50, 100);
  rect(205, 270, 50, 100);

  line(200, 270, 200, 370);

  fill(40, 40, 40);
  rect(145, 350, 50, 25);
  rect(205, 350, 50, 25);
}

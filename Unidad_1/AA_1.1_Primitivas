function setup() {
  createCanvas(400, 400);

  background(130, 200, 255);

  stroke(0);

  fill(180, 130, 90);
  rect(140, 50, 120, 120);

  fill(90, 50, 30);
  rect(140, 50, 120, 30);

  fill(255);
  rect(160, 100, 20, 15);
  rect(220, 100, 20, 15);

  fill(0, 0, 200);
  rect(168, 100, 10, 15);
  rect(220, 100, 10, 15);

  fill(120, 70, 40);
  triangle(190, 120, 210, 120, 200, 135);

  line(185, 150, 215, 150);

  fill(0, 180, 180);
  rect(140, 170, 120, 100);

  fill(180, 130, 90);
  rect(100, 170, 40, 100);
  rect(260, 170, 40, 100);

  circle(120, 280, 30);
  circle(280, 280, 30);

  fill(50, 50, 180);
  rect(145, 270, 50, 100);
  rect(205, 270, 50, 100);

  line(200, 270, 200, 370);

  fill(40);
  rect(145, 350, 50, 25);
  rect(205, 350, 50, 25);
}

